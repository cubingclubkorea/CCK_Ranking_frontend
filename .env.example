VITE_API_URL=/api/v1
VITE_SSO_URL={ SSO_URL }
VITE_LOGIN_URL={ LOGIN_URL_WITH_REDIRECT_URI }
VITE_ANALYTICS_ID=your-analytics-id

VITE_EVENT_ICON_BASE_URL=/icon/events

# Add other public VITE_* variables here. Do NOT put secrets.
# Dev tip:
# - Mobile/IP/ngrok 테스트 시 CORS 이슈를 피하려면 VITE_API_URL을 /api/v1 로 사용하세요.
# Copy to `.env.local` for local overrides and keep `.env.local` out of git.
